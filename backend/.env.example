# PostgreSQL connection string (required). Must match prisma/schema.prisma provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# Used to sign and verify JWTs for admin routes (use a long random string in production).
JWT_SECRET="change-me-to-a-long-random-secret"

# Plain-text password checked on POST /api/auth/login (demo-style single admin).
ADMIN_PASSWORD="change-me"

# Optional. Default 5000.
PORT=5000
